{
  "name": "convert-everything",
  "version": "2.0.0",
  "description": "Dependency-free unit conversion library for length, area, volume, time, temperature, energy, pressure, data storage, weight, speed, power, frequency, and angle.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit",
    "build:types": "node scripts/generate-types.js",
    "check:types": "node scripts/generate-types.js --check",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run check:types && npm run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varadaraj772/convert-everything.git"
  },
  "keywords": [
    "convert",
    "converter",
    "conversion",
    "units",
    "units-converter",
    "unit-conversion",
    "measurement",
    "length",
    "area",
    "volume",
    "temperature",
    "weight",
    "data",
    "speed",
    "power",
    "frequency",
    "angle",
    "unit-parser",
    "unit-formatter",
    "zero-dependencies",
    "convert-everything"
  ],
  "author": "Varadaraj Acharya",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/varadaraj772/convert-everything/issues"
  },
  "homepage": "https://github.com/varadaraj772/convert-everything#readme",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
